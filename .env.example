# Local LLM
local_model_url=http://localhost:8989/v1
local_model_name=qwen3.5
local_model_temperature=0.1
local_model_max_tokens=1024
local_model_api_key=your_api_key_here

# Embedding
embedding_url=http://localhost:8988
embedding_model_name=bge-m3
embedding_model_key=your_api_key_here

# Rerank
rerank_url=http://localhost:8987
rerank_model_name=bge-reranker
rerank_api_key=your_api_key_here

# DingTalk
DINGTALK_CLIENT_ID=your_client_id
DINGTALK_CLIENT_SECRET=your_client_secret

# Feishu
FEISHU_APP_ID=your_app_id
FEISHU_APP_SECRET=your_app_secret

# Advanced LLM
advanced_model_url=https://api.minimaxi.com/v1
advanced_model_key=your_api_key_here
advanced_model_name=MiniMax-M2.7